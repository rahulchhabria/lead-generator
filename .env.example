# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - falls back to duckduckgo-search if not provided
SERPER_API_KEY=your-serper-key-here

# Optional - falls back to email pattern generation + DNS verification
HUNTER_API_KEY=your-hunter-key-here

# Optional - falls back to unauthenticated (60 req/hr vs 5000/hr)
GITHUB_TOKEN=ghp_your-token-here

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-20250514
DB_PATH=data/pipeline.db
LOG_LEVEL=INFO
