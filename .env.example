# ============================================================
# Prospect Intelligence - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: Search (falls back to DuckDuckGo) ---
SERPER_API_KEY=your-serper-key-here

# --- Optional: Email Finding (falls back to pattern+DNS) ---
HUNTER_API_KEY=your-hunter-key-here

# --- Optional: GitHub (falls back to 60 req/hr unauthenticated) ---
GITHUB_TOKEN=ghp_your-token-here

# --- Web Server ---
PORT=8000

# --- Database ---
DB_PATH=data/pipeline.db

# --- AI Model ---
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Production: JWT Auth (set a strong random value) ---
# SECRET_KEY=generate-with-openssl-rand-hex-32

# --- Production: Error Tracking ---
# SENTRY_DSN=https://your-sentry-dsn

# --- Logging ---
LOG_LEVEL=INFO
